{
  "name": "@upstash/blob",
  "version": "0.0.0",
  "description": "SDK for Upstash Blob: server, browser and React uploads",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "browser": [
        "./dist/browser.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "bun test --timeout 60000",
    "check": "bun run typecheck && bun run lint && bun run build && attw --pack . && publint",
    "test:unit": "bun test test/unit --timeout 60000",
    "test:live": "bun test test/live --timeout 60000",
    "check:pack": "attw --pack . && publint"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@aws-sdk/client-s3": "3.1116.0",
    "@happy-dom/global-registrator": "20.11.6",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.0",
    "publint": "0.3.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upstash/blob-js.git"
  },
  "homepage": "https://upstash.com/docs/blob",
  "bugs": {
    "url": "https://github.com/upstash/blob-js/issues"
  },
  "keywords": [
    "upstash",
    "blob",
    "storage",
    "s3",
    "r2",
    "upload"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
